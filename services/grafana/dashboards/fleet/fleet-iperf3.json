{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firing / pending alerts",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (alertname, severity) (ALERTS{alertname=~\"TailscaleNodeThroughput.*\"})",
          "legendFormat": "{{alertname}} ({{severity}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Coordinators active",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(systemd_unit_state{name=\"iperf3-speedtest-coordinator.service\",state=\"active\",host=~\"$host\"} == 1)",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed pairs",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(node_network_throughput_iperf3_test_failed{host=~\"$host\",target=~\"$target\"}) or vector(0)",
          "legendFormat": "failed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stale pairs (>10m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((time() - node_network_throughput_iperf3_last_run_timestamp{host=~\"$host\",target=~\"$target\"}) > 600) or vector(0)",
          "legendFormat": "stale",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Latest upload (local LAN)",
      "description": "proxmox-* to proxmox-*. Alert TailscaleNodeThroughputLowLocal fires below 1 Gbps.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "custom": {
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1000000000 },
              { "color": "green", "value": 5000000000 }
            ]
          }
        }
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_network_throughput_iperf3_upload_bps{host=~\"$host\",target=~\"$target\",host=~\"proxmox-.*\",target=~\"proxmox-.*\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "instance": true,
              "job": true
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "target",
            "rowField": "host",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Latest upload (WAN / cross-site)",
      "description": "Pairs that are not proxmox-to-proxmox. Capped at 120 Mbps. Alert TailscaleNodeThroughputLowWAN fires below 100 Mbps.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "custom": {
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50000000 },
              { "color": "green", "value": 100000000 }
            ]
          }
        }
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_network_throughput_iperf3_upload_bps{host=~\"$host\",target=~\"$target\"} unless node_network_throughput_iperf3_upload_bps{host=~\"proxmox-.*\",target=~\"proxmox-.*\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "instance": true,
              "job": true
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "target",
            "rowField": "host",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest pair results",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/Upload/" },
            "properties": [
              { "id": "unit", "value": "bps" },
              { "id": "decimals", "value": 1 },
              { "id": "displayName", "value": "Upload" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 100000000 },
                    { "color": "green", "value": 1000000000 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/Download/" },
            "properties": [
              { "id": "unit", "value": "bps" },
              { "id": "decimals", "value": 1 },
              { "id": "displayName", "value": "Download" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 100000000 },
                    { "color": "green", "value": 1000000000 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/Failed/" },
            "properties": [
              { "id": "displayName", "value": "Failed" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "ok", "color": "green" },
                      "1": { "text": "failed", "color": "red" }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/Age/" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 0 },
              { "id": "displayName", "value": "Age" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 600 },
                    { "color": "red", "value": 7200 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "pair", "desc": false }]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(label_join(node_network_throughput_iperf3_upload_bps{host=~\"$host\",target=~\"$target\"}, \"pair\", \" → \", \"host\", \"target\"), \"kind\", \"Upload\", \"\", \"\") or label_replace(label_join(node_network_throughput_iperf3_download_bps{host=~\"$host\",target=~\"$target\"}, \"pair\", \" → \", \"host\", \"target\"), \"kind\", \"Download\", \"\", \"\") or label_replace(label_join(node_network_throughput_iperf3_test_failed{host=~\"$host\",target=~\"$target\"}, \"pair\", \" → \", \"host\", \"target\"), \"kind\", \"Failed\", \"\", \"\") or label_replace(label_join(time() - node_network_throughput_iperf3_last_run_timestamp{host=~\"$host\",target=~\"$target\"}, \"pair\", \" → \", \"host\", \"target\"), \"kind\", \"Age\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "host": true,
              "instance": true,
              "job": true,
              "target": true
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "kind",
            "rowField": "pair",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "pair\\kind": "pair"
            },
            "indexByName": {
              "pair": 0,
              "Upload": 1,
              "Download": 2,
              "Failed": 3,
              "Age": 4
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Local LAN upload",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_network_throughput_iperf3_upload_bps{host=~\"$host\",target=~\"$target\",host=~\"proxmox-.*\",target=~\"proxmox-.*\"}",
          "legendFormat": "{{host}} → {{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Local LAN download",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
