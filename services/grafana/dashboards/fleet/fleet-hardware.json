{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Firing / pending alerts (Hardware, SR-IOV, GPU)",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (alertname, severity) (ALERTS{alertname=~\"Proxmox.*|SRIOV.*|Hardware.*|IntelGPU.*|VFIODriver.*|PCIe.*|VMHighCPUSteal\", alertstate=\"firing\"})",
          "legendFormat": "{{alertname}} ({{severity}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Proxmox Package Temp",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_hwmon_temp_celsius{host=\"proxmox\",chip=\"platform_coretemp_0\",sensor=\"temp1\"}",
          "legendFormat": "Package Temp",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "VFIO iGPU Bound",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "UNBOUND" }, "1": { "text": "BOUND (vfio-pci)" } } }
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_hardware_pci_driver_bound{device_name=\"igpu\"}",
          "legendFormat": "00:02.0",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "SR-IOV Configured VFs",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 16 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_sriov_numvfs_configured{interface=\"enp2s0f1np1\"}",
          "legendFormat": "enp2s0f1np1 VFs",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Intel GPU Media Freq (QSV)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MHz",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "intel_gpu_frequency_actual_mhz{gt=\"gt1\",host=\"proxmox-applications-1\"}",
          "legendFormat": "apps-1 GT1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Proxmox CPU Core & Package Temperatures",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_hwmon_temp_celsius{host=\"proxmox\",chip=\"platform_coretemp_0\"}",
          "legendFormat": "{{sensor}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Intel CPU Package Throttling Rate & Hypervisor Swap I/O",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_cpu_package_throttles_total{host=\"proxmox\"}[5m])",
          "legendFormat": "Throttle rate (events/s)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_vmstat_pswpin{host=\"proxmox\"}[5m])",
          "legendFormat": "Swap In (pages/s)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_vmstat_pswpout{host=\"proxmox\"}[5m])",
          "legendFormat": "Swap Out (pages/s)",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Guest SR-IOV iavf Packet Drop Rate (per VM eth0)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_network_receive_drop_total{device=\"eth0\",host=~\"proxmox-.*\"}[5m])",
          "legendFormat": "{{host}} rx_drop",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_network_transmit_drop_total{device=\"eth0\",host=~\"proxmox-.*\"}[5m])",
          "legendFormat": "{{host}} tx_drop",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hypervisor Host PF Per-VF Dropped Packets Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_sriov_vf_rx_dropped_total[5m])",
          "legendFormat": "VF {{vf}} ({{mac}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "VM vCPU Steal Time Percentage (Hypervisor Contention)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (host) (rate(node_cpu_seconds_total{mode=\"steal\",host=~\"proxmox-.*\"}[5m])) * 100",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Intel Xe GPU Engine Frequencies & DRM Clients (proxmox-applications-1)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "intel_gpu_frequency_actual_mhz{host=\"proxmox-applications-1\"}",
          "legendFormat": "{{gt}} actual MHz",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "intel_gpu_drm_clients_total{host=\"proxmox-applications-1\"}",
          "legendFormat": "DRM clients count",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "intel_gpu_resets_total{host=\"proxmox-applications-1\"}",
          "legendFormat": "engine resets (cumulative)",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hardware Errors — RAS MCE / PCIe AER / DMAR (proxmox)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_ras_mce_records_total{host=\"proxmox\"}",
          "legendFormat": "MCE records",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_ras_aer_events_total{host=\"proxmox\"}",
          "legendFormat": "PCIe AER events (rasdaemon)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_ras_mc_events_total{host=\"proxmox\"}",
          "legendFormat": "Memory controller events",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_hardware_dmar_faults_total{host=\"proxmox\"}",
          "legendFormat": "DMAR/IOMMU faults (this boot)",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "X710 Carrier Changes — PF & VF Link Flaps (proxmox)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(node_network_carrier_changes_total{host=\"proxmox\",device=~\"enp2s0.*\"}[15m])",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "fleet",
    "hardware",
    "sriov",
    "gpu"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fleet Hardware, SR-IOV & GPU Passthrough",
  "uid": "fleet-hardware",
  "version": 1
}
