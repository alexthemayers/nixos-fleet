{% set journal_remap = lookup('file', debian_guest_vector_config_dir ~ '/journal-remap.vrl') | replace('@host@', debian_guest_tailscale_hostname) %}
{% set loki_sink = lookup('file', debian_guest_vector_config_dir ~ '/loki-sink.json') | from_json
   | combine({'inputs': ['journal_remap'], 'endpoint': debian_guest_loki_endpoint}) %}
# Managed by fleet.debian_guest. Do not edit. Pipeline source: config/vector/
# (shared with the NixOS hosts and the Proxmox host).
data_dir: /var/lib/vector

sources:
  journald:
    type: journald
    current_boot_only: true
  internal_metrics:
    type: internal_metrics

transforms:
  journal_remap:
    type: remap
    inputs:
      - journald
    source: |
{{ journal_remap | indent(6, true) }}

sinks:
  loki:
{{ loki_sink | to_nice_yaml(indent=2) | indent(4, true) }}
  prometheus_exporter:
    type: prometheus_exporter
    inputs:
      - internal_metrics
    address: "0.0.0.0:9598"
