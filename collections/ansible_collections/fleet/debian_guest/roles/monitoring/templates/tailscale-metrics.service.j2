[Unit]
Description=Tailscale client metrics
After=tailscaled.service
Wants=tailscaled.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/tailscale web --readonly --listen {{ debian_guest_exporter_ip }}:9251
