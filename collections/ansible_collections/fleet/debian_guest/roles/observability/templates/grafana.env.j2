GF_SERVER_HTTP_ADDR=0.0.0.0
GF_SERVER_DOMAIN=grafana.alexmayers.co.za
GF_SERVER_ROOT_URL=https://grafana.alexmayers.co.za/
GF_LIVE_ALLOWED_ORIGINS=https://grafana.alexmayers.co.za
GF_LOG_CONSOLE_FORMAT=json
GF_PATHS_DATA=/var/lib/grafana
GF_PATHS_PROVISIONING=/etc/grafana/provisioning
GF_DATABASE_TYPE=postgres
GF_DATABASE_URL=postgres://grafana:{{ debian_guest_secrets.postgres.grafana_password | urlencode }}@xcloud-postgres:5432/grafana?sslmode=disable&binary_parameters=yes
GF_DATABASE_MAX_OPEN_CONN=5
GF_DATABASE_MAX_IDLE_CONN=5
GF_SECURITY_ADMIN_EMAIL=a.mayers102@gmail.com
GF_SECURITY_ADMIN_PASSWORD={{ debian_guest_secrets.grafana.admin_password }}
GF_SECURITY_SECRET_KEY={{ debian_guest_secrets.grafana.secret_key }}
GF_AUTH_LOGIN_MAXIMUM_INACTIVE_LIFETIME_DURATION=30m
GF_AUTH_LOGIN_MAXIMUM_LIFETIME_DURATION=10h
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak-OAuth
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ debian_guest_secrets.grafana.oauth_secret }}
GF_AUTH_GENERIC_OAUTH_USE_REFRESH_TOKEN=true
GF_AUTH_GENERIC_OAUTH_AUTH_TOKEN_REFRESH=true
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile offline_access
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://identity.alexmayers.co.za/realms/master/protocol/openid-connect/auth
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://identity.alexmayers.co.za/realms/master/protocol/openid-connect/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://identity.alexmayers.co.za/realms/master/protocol/openid-connect/userinfo
GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL=https://identity.alexmayers.co.za/realms/master/protocol/openid-connect/logout?post_logout_redirect_uri=https://grafana.alexmayers.co.za/login
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(roles[*], 'grafana:admin') && 'GrafanaAdmin' || contains(roles, 'grafana:admin') && 'GrafanaAdmin' || contains(roles[*], 'grafana:read') && 'Viewer' || contains(roles, 'grafana:read') && 'Viewer'
