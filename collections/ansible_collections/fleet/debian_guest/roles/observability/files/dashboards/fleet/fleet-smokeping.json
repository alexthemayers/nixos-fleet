{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Firing / pending alerts",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (alertname, severity) (ALERTS{alertname=~\"TailscaleNodeHighPacketLoss|TailscaleNodeHighLatency\"})",
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Packet loss % (alerted targets)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (host, exported_host) (rate(smokeping_requests_total{exported_host!~\"gaming.*|m3pro.*\"}[5m])) - sum by (host, exported_host) (rate(smokeping_response_duration_seconds_count{exported_host!~\"gaming.*|m3pro.*\"}[5m]))) / sum by (host, exported_host) (rate(smokeping_requests_total{exported_host!~\"gaming.*|m3pro.*\"}[5m])) * 100",
          "legendFormat": "{{host}} \u2192 {{exported_host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RTT ms (alerted targets)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (host, exported_host) (rate(smokeping_response_duration_seconds_sum{exported_host!~\"gaming.*|m3pro.*\"}[5m])) / sum by (host, exported_host) (rate(smokeping_response_duration_seconds_count{exported_host!~\"gaming.*|m3pro.*\"}[5m]))) * 1000",
          "legendFormat": "{{host}} \u2192 {{exported_host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate (all targets)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (host, exported_host) (rate(smokeping_requests_total[5m]))",
          "legendFormat": "{{host}} \u2192 {{exported_host}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "fleet",
    "smokeping",
    "tailscale"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Smokeping (alerts)",
  "uid": "fleet-smokeping",
  "version": 1
}
