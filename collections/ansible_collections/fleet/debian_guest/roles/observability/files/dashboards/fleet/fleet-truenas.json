        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(disk_utilization{job=\"truenas\"}[15m])",
          "legendFormat": "{{disk}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU iowait",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
