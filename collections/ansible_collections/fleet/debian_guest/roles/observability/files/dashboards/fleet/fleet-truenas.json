        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "cpu_total{job=\"truenas\",kind=\"iowait\"}",
          "legendFormat": "iowait",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Primary NIC up",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
