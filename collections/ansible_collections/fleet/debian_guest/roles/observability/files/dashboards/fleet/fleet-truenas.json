        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "interface_operationstate{job=\"truenas\",interface=\"enp6s16\",state=\"up\"}",
          "legendFormat": "enp6s16",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Clock synced",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
