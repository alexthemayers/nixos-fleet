#!/bin/bash
# Prometheus dials this guest by its MagicDNS name. Debian's 127.0.1.1 line
# also carries that name, so the dial hits loopback, where the exporters
# are not listening.
set -euo pipefail

# tailscaled starts before it has logged in; give it a minute.
ip=""
for _ in $(seq 1 30); do
  ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  [[ -n "$ip" ]] && break
  sleep 2
done
[[ -n "$ip" ]] || { echo "no tailnet address" >&2; exit 1; }
hn="$(hostname)"
mark="fleet-observability-hostname"
tmp="$(mktemp)"

awk -v hn="$hn" -v mark="$mark" '
  $0 ~ mark { next }
  $1 == "127.0.1.1" {
    out = $1
    for (i = 2; i <= NF; i++) if ($i != hn) out = out " " $i
    print out
    next
  }
  { print }
' /etc/hosts >"$tmp"

{
  echo "$ip $hn # $mark"
  cat "$tmp"
} > /etc/hosts
rm -f "$tmp"
